  <!-- Aggregation/Composition (owns/contains members) -->
  <!-- PointLight has LightBuffer member -->
  <Association Name="PointLight.lightBuffer" From="PointLight" To="ConstantBuffer" Type="Aggregation" Label="LightBuffer (CPU-side data)"/>
  <!-- Scene owns Actors/Components/Models -->
  <Association Name="Scene->Actor" From="Scene" To="Actor" Type="Aggregation" Label="actors[]" />
  <Association Name="Scene->SceneComponent" From="Scene" To="SceneComponent" Type="Aggregation" Label="components[]" />
  <Association Name="Scene->Model" From="Scene" To="Model" Type="Aggregation" Label="models[]" />
  <!-- MeshActor owns MeshComponent/Material/Model -->
