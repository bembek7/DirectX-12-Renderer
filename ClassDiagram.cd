  <Association Name="MeshActor->Material" From="MeshActor" To="Material" Type="Aggregation" Label="material" />
  <Association Name="MeshActor->Model" From="MeshActor" To="Model" Type="Aggregation" Label="model" />
  <!-- Pools manage bindables/shaders/pipeline states -->
  <Association Name="BindablesPool->Bindable" From="BindablesPool" To="Bindable" Type="Aggregation" Label="cache" />
